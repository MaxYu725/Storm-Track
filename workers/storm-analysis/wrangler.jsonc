{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Independent analysis Worker. Do not point this at the production Storm Worker database.
  "name": "storm-analysis",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  // AI-18: require both independent authorization domains on future deploys.
  // Secret values remain only in Cloudflare/GitHub Secrets and are never stored here.
  "secrets": {
    "required": ["BACKFILL_TOKEN", "ANALYSIS_ADMIN_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "ANALYSIS_DB",
      "database_name": "storm-analysis",
      // AI-17 independent analysis database. Never replace this with the production Storm Worker database ID.
      "database_id": "99c692b2-c932-4774-bf8d-2d7f10f6c6f8",
      "migrations_dir": "schema"
    }
  ]
}
